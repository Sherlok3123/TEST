0x413F9E00 — Record freshness gate (record fetch)
----------------------------------------
Purpose: Validates a record against server-tick staleness and writes the tick
   correction to record+0xAC. Returns record pointer in ecx if fresh, else 0.
   Contains the exact immediate patched by extrapolation_limit.
Confidence: OBSERVED.
Direct callers: 0x4148F2A8, 0x414964F9, 0x41496546, 0x4149F9E1, 0x4149FABA.
Callees: [eax+0x28] virtual call, 0x41343B20, [ecx+0x34] virtual call.
Key instructions (OBSERVED):
   0x413F9EA8: mov eax,[0x4223F428]      ; ctx
   0x413F9EAD: mov eax,[eax+0x16C]       ; server tick
   0x413F9EB3: sub eax,[edx+0x84]        ; - record.tick   (edx = record)
   0x413F9EB9: mov ecx,eax
   0x413F9EBB: neg ecx
   0x413F9EBD: cmovs ecx,eax             ; ecx = |delta|
   0x413F9EC0: cmp ecx,2                 ; <-- extrapolation_limit patch site
   0x413F9EC3: mov ecx,0
   0x413F9EC8: ja  0x413F9F0B            ; too stale -> return 0
   0x413F9ECA: mov eax,[0x424F4B18]      ; tick correction
   0x413F9ECF: mov [edx+0xac],eax        ; record+0xAC = correction
   0x413F9ED5: mov ecx,edx               ; return record
   0x413F9ED7: jmp  0x413F9F0B
Confirmed by Lua pattern in REFRACTED.lua:213-216:
   {0xF7,0xD9,0x0F,0x48,0xC8,0x83,0xF9,nil,0xB9,0,0,0,0,0x77} -> addr+7
   Starting at F7 D9 (neg ecx) = 0x413F9EBB; addr+7 = 0x413F9EC2 = the "02"
   immediate. Exactly matches binary.
---- Pseudocode (reconstructed) ----
record* fetch_record(ring* r, ...) {
    head = r->head; mask = r->mask; records = r->records;
    idx = (head - 1) & mask;
    rec = records[idx];
    if (rec->flags & 8) goto reject;
    delta = ctx->server_tick - rec->tick;   // [ctx+0x16C] - [rec+0x84]
    adelta = abs(delta);
    if (adelta > 2) goto reject;            // cmp ecx,2 ; ja
    rec->tick_correction = *(uint32_t*)0x424F4B18;   // [rec+0xAC]
    return rec;
reject:
    return 0;
}

