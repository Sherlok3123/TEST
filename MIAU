0x4148F180 — Record selection (nearest-record search)
----------------------------------------
Purpose: Walks the record ring, skips records with flags&8, computes a 3D
   euclidean distance from a target origin to each record position (z term uses
   record.z + record.vz*0.5 half-tick projection), keeps the minimum, returns
   best record index in eax.
Confidence: OBSERVED (fully disassembled).
Direct callers: exactly one, 0x4149789F.
Callees: 0x413F9E00 (record fetch).
Key instructions (OBSERVED):
   Prologue: 0x4148F180 push ebp;push ebx;push edi;push esi;sub esp,0x10
   Call site args at 0x41497897-0x4149789F:
       lea edx,[esi+0x10]    ; arg4 = &out_origin
       push eax               ; arg3 = record index / array element
       push ecx               ; arg2 = tick-derived value
       push [esi]             ; arg1 = entity pointer
       call 0x4148F180
   Distance metric at 0x4148F46C-0x4148F4B0:
       mov ecx,[esp+0x30]     ; target origin ptr
       movss xmm0,[ecx]       ; target.x
       subss xmm0,[eax]       ; - record.x  (record+0x00)
       movss xmm1,[eax+0x38]  ; record velocity component
       mulss xmm1,[0x4205A518]; * 0.5
       addss xmm1,[eax+8]     ; + record.z  (record+0x08)
       mulss xmm0,xmm0        ; dx^2
       movsd xmm2,[ecx+4]     ; target.y,target.z
       movss xmm3,[eax+4]     ; record.y
       unpcklps xmm3,xmm1     ; {record.y, predicted_z}
       subps xmm2,xmm3        ; {dy, dz}
       mulps xmm2,xmm2
       addss xmm0,xmm2
       shufps xmm2,xmm2,0x55
       addss xmm2,xmm0
       sqrtss xmm0,xmm2       ; distance
   SIMD tail 0x4148F640-0x4148F778: vectorized min/max reduction over
   [0x42504EDC]; not position arithmetic.
Record layout inferred: +0x00=x, +0x04=y, +0x08=z origin; +0x38 velocity-like;
   +0x84 tick; +0xAC correction/out-ptr; +0xB0 flags word; +0xB1 flags byte
   (bit 3 = 0x08 tested).
---- Pseudocode (reconstructed) ----
int select_record(entity* ent, int tick_arg, int idx, vec3* out) {
    // walks ring, skips flags&8, min distance
    best = -1; best_dist = FLT_MAX;
    for each record r:
        if (r->flags & 8) continue;
        pred_z = r->z + r->vel * 0.5f;      // [0x4205A518] = 0.5f
        dist = hypot(target - (r->x, r->y, pred_z));
        if (dist < best_dist) { best_dist = dist; best = r; }
    *out = best->origin;
    return best_index;
}

